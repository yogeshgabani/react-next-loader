{
  "name": "react-loadify",
  "version": "0.1.0",
  "description": "All-in-one React loader library: spinners, skeletons, progress bars, fullscreen loaders, button states, and page-transition bars with theming, SSR support, and tree-shaking.",
  "keywords": [
    "react",
    "loader",
    "spinner",
    "skeleton",
    "progress",
    "loading",
    "shimmer",
    "fullscreen-loader",
    "next.js",
    "vite",
    "remix",
    "framer-motion",
    "lottie",
    "ssr",
    "accessible"
  ],
  "license": "MIT",
  "author": "react-loadify contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-loadify.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/react-loadify/issues"
  },
  "homepage": "https://github.com/your-org/react-loadify#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js",
      "require": "./dist/loaders/index.cjs"
    },
    "./skeletons": {
      "types": "./dist/skeletons/index.d.ts",
      "import": "./dist/skeletons/index.js",
      "require": "./dist/skeletons/index.cjs"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "import": "./dist/progress/index.js",
      "require": "./dist/progress/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup --watch",
    "playground": "vite --config playground/vite.config.ts",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "publint": "publint",
    "attw": "attw --pack .",
    "prepublishOnly": "npm run build && npm run publint"
  },
  "peerDependencies": {
    "framer-motion": ">=10",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
